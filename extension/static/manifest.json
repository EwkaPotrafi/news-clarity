{
  "manifest_version": 3,
  "name": "News Clarity",
  "short_name": "News Clarity",
  "version": "1.0.0",
  "description": "Spokojna, rzeczowa ocena artykułu: fakty, twierdzenia, interpretacje. A calm, fair read of the news.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "News Clarity", "default_icon": { "16": "icons/16.png", "48": "icons/48.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["sidePanel", "scripting", "activeTab", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"]
}
